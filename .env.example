# Copiá este archivo a .env y completá lo que falte.
# El repo NO lleva claves: acá van sólo los nombres de las variables y valores de ejemplo.

# --- Modelo de chat -------------------------------------------------------------------
# Proveedor: gemini | openai | anthropic (el cliente multi-proveedor elige con esta variable)
LLM_PROVIDER=gemini

# Se completa con la que corresponda al proveedor elegido. Sin la key del proveedor elegido
# el sistema NO arranca (y dice cuál falta): degradar en silencio esconde errores.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo por proveedor (tienen default, se pueden pisar)
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Conocimiento (RAG) ---------------------------------------------------------------
# Los documentos viven en data/ y se indexan con scripts/ingest.py.
INDEX_NAME=the-intelligence-system
PINECONE_API_KEY=
PINECONE_NAMESPACE=politicas-internas
PINECONE_REGION=us-east-1
# Sin PINECONE_API_KEY el recuperador arranca en modo léxico (BM25) y el sistema anda igual.

# --- Cola, estado y checkpoints -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
WORKER_CONCURRENCIA=3
# Cuánto vive el estado de un trabajo en Redis y cuánto se espera una aprobación humana
JOB_TTL_SEGUNDOS=86400
MINUTOS_ESPERA_APROBACION=15
# Tope de tiempo por trabajo: si el equipo de agentes se pasa, el trabajo queda en FALLO
JOB_TIMEOUT_SEGUNDOS=300
# A partir de este costo estimado, una acción se considera crítica y pide aprobación
UMBRAL_COSTO_APROBACION=0.02

# --- Observabilidad -------------------------------------------------------------------
# Con esto seteado, cada nodo del grafo deja su traza. Vacío = el sistema corre sin trazas
# (lo avisa por log en vez de fallar en silencio).
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=the-intelligence-system

# --- Varios ---------------------------------------------------------------------------
LOG_LEVEL=INFO
